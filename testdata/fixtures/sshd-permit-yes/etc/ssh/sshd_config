# Left as the vendor appliance shipped it.
Port 22

PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords yes
HostbasedAuthentication yes
IgnoreRhosts no
StrictModes no
UsePAM no
MaxAuthTries 10
LoginGraceTime 300

X11Forwarding yes
AllowTcpForwarding yes
AllowAgentForwarding yes
PermitUserEnvironment yes

ClientAliveInterval 0
ClientAliveCountMax 3

LogLevel ERROR
Banner none

Ciphers aes256-ctr,aes128-cbc,3des-cbc,arcfour
MACs hmac-sha2-256,hmac-sha1,hmac-md5,umac-64@openssh.com
KexAlgorithms curve25519-sha256,diffie-hellman-group1-sha1,diffie-hellman-group14-sha1
