# Fixture unit with real contents, unlike the placeholders beside it:
# dbus.service is in fact.SandboxTargets, so SERVICES-0006 reads this file.
[Unit]
Description=D-Bus System Message Bus

[Service]
ExecStart=/usr/bin/dbus-daemon --system --address=systemd: --nofork
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
